# Public hostname served by this deployment (Traefik Host rule).
TWEB_HOST=tg.example.com

# Image published by .github/workflows/build.yml
TWEB_IMAGE=ghcr.io/<owner>/tweb-relay:latest
TWEB_CONTAINER=tweb
TWEB_ROUTER=tweb

# Existing Docker network Traefik watches, and its entrypoint/cert resolver names.
TRAEFIK_NETWORK=traefik
TRAEFIK_ENTRYPOINT=https
TRAEFIK_CERTRESOLVER=le

# Only used when building locally (docker-compose.build.yml). In CI the same
# values come from the TWEB_API_ID / TWEB_API_HASH repository secrets.
TWEB_API_ID=
TWEB_API_HASH=
