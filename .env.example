# Public hostname of the deployment.
# - Traefik variant (docker-compose.yml): used as the Traefik Host rule.
# - Standalone variant (docker-compose.standalone.yml): Caddy obtains a
#   certificate for it, so 80/443 must be reachable and DNS must point at
#   the host.
TWEB_HOST=tg.example.com

# Telegram api_id / api_hash from https://my.telegram.org
# (API development tools). They are baked into the JavaScript at build time —
# the app identifies itself with them, so use your own pair.
TWEB_API_ID=
TWEB_API_HASH=

# Optional: upstream tweb ref to build (branch, tag or commit).
#TWEB_REF=master

# Container name and Traefik router name (Traefik variant).
TWEB_CONTAINER=tweb
TWEB_ROUTER=tweb

# Traefik variant only: external Docker network Traefik watches, and its
# entrypoint / cert resolver names.
TRAEFIK_NETWORK=traefik
TRAEFIK_ENTRYPOINT=https
TRAEFIK_CERTRESOLVER=le
